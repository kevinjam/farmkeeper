# Production Environment Variables
# Set these in your deployment platform (Vercel, etc.)

# Backend API URL for production
NEXT_PUBLIC_BACKEND_URL=https://farmkeep-backend.onrender.com
BACKEND_BASE_URL=https://farmkeep-backend.onrender.com/api

# Frontend URL for production
NEXT_PUBLIC_FRONTEND_URL=https://farmkeeper.vercel.app
FRONTEND_URL=https://farmkeeper.vercel.app

# Google OAuth (required for production)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Weather API (OpenWeatherMap)
# WEATHER_API_KEY=your_openweathermap_api_key_here

# Database (if needed)
# DATABASE_URL=your_database_url_here

# JWT Secret (if needed)
# JWT_SECRET=your_jwt_secret_here
