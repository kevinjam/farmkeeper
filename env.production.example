# Production Environment Variables
# Set these in your deployment platform (Vercel, etc.)

# Backend API URL for production (AWS EC2 via api.farmkeeper.co)
NEXT_PUBLIC_BACKEND_URL=https://api.farmkeeper.co
BACKEND_BASE_URL=https://api.farmkeeper.co/api
BACKEND_URL=https://api.farmkeeper.co

# Frontend URL for production
NEXT_PUBLIC_FRONTEND_URL=https://app.farmkeeper.co
FRONTEND_URL=https://app.farmkeeper.co

# Google OAuth (required for production)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Weather API (OpenWeatherMap)
# WEATHER_API_KEY=your_openweathermap_api_key_here
